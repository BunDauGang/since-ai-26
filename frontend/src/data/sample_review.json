        "S002",
        "S017"
      ],
      "status": "AI_GENERATED_FROM_CALCULATED_DATA",
      "confidence": "High"
    },
    {
      "id": "OBS3",
      "title": "15,233 repairs extended garment life and avoided new-product emissions",
      "observation": "Lindström completed 15,233 garment repairs in 2025 (20.33 repairs per 1,000 washes). Under prototype assumption A002 (0.5 to 1.0 postponed replacements per repair), this postponed 7,617 to 15,233 new garment replacements and avoided an estimated 113,182 to 226,363 kgCO2e in new-product footprint.",
      "recommended_action": "Review high-repair production sites to check whether mechanical wear on Food Industry Coats and Work Trousers can be reduced through garment specification updates.",
      "owner": "Lindström Account Team",
      "steering_question": "Which production lines drive the highest zipper and patching repair rates at our top-repair plants?",
      "metric_ids": [
        "repairs_total",
        "replacements_postponed",
        "avoided_product_co2e_kg"
      ],
