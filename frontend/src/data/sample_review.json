  "observations": [
    {
      "id": "OBS1",
      "title": "1.41M litres of estimated water savings vs outsourced local laundry",
      "observation": "Across 502,074.7 kg of washed textiles in 2025, NorthStar Foods Group achieved an allocated estimate of 1,406,482.6 L in fresh-water savings (sensitivity range: 499,886 L to 2,313,079 L) and 255,073.1 kgCO2e in process and delivery emission reductions compared with the outsourced local laundry baseline.",
      "recommended_action": "Use the allocated water and Scope 3 emission evidence in the annual steering review, and validate laundry-specific meter factors with Lindström sustainability specialists before external reporting.",
      "owner": "Both",
      "steering_question": "Should we align our 2026 water-intensity targets around outsourced local laundry or in-house laundry as the primary benchmark?",
      "metric_ids": [
        "water_saving_l",
        "co2e_saving_kg",
        "washed_kg"
      ],
      "site_ids": [
        "S001",
        "S002",
        "S016"
      ],
      "status": "AI_GENERATED_FROM_CALCULATED_DATA",
      "confidence": "Low-Medium"
    },
    {
      "id": "OBS2",
      "title": "Garment allocation optimization opportunity across lowest-utilization sites",
      "observation": "In December 2025, 31,743 garments were allocated across 24 sites with an overall active scan utilization of 83.5% (5230 unscanned pieces). The lowest-utilization sites (NorthStar Kotka at 75.6% and NorthStar Helsinki at 76.2%) hold excess buffer stock.",
      "recommended_action": "Right-size locker allocations at the 5 lowest-utilization sites during Q1 2026 to reduce idle stock and improve circulation efficiency.",
      "owner": "Lindström & Customer Site Ops",
      "steering_question": "Can we pilot an allocation rebalance at the 5 lowest-utilization sites without affecting shift availability?",
      "metric_ids": [
        "allocation_use_rate",
        "idle_pieces",
        "garments_allocated"
      ],
      "site_ids": [
        "S010",
        "S001",
